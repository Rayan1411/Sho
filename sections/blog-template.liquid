<div class="collection-header">
  <div class="container">
    <h1>{{ blog.title }}</h1>
  </div>
</div>

<section class="section">
  <div class="container">
    {%- paginate blog.articles by 9 -%}
    <div class="products-grid">
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" style="display:block;border:1px solid var(--c-border);border-radius:var(--r);overflow:hidden;transition:var(--t);text-decoration:none;" onmouseover="this.style.boxShadow='var(--shadow)'" onmouseout="this.style.boxShadow='none'">
          {%- if article.image -%}
            <img src="{{ article.image | img_url: '400x250', crop: 'center' }}" alt="{{ article.title | escape }}" loading="lazy" width="400" height="250" style="width:100%;aspect-ratio:16/10;object-fit:cover;">
          {%- endif -%}
          <div style="padding:20px;{% if request.locale.iso_code == 'ar' %}text-align:right;{% endif %}">
            <p style="font-size:0.75rem;color:var(--c-text-m);margin-bottom:8px;">{{ article.published_at | date: '%d %b %Y' }}</p>
            <h3 style="font-size:1rem;font-weight:700;color:var(--c-text);margin-bottom:8px;line-height:1.4;">{{ article.title }}</h3>
            <p style="font-size:0.875rem;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;">{{ article.excerpt_or_content | strip_html }}</p>
          </div>
        </a>
      {%- endfor -%}
    </div>
    {%- render 'pagination', paginate: paginate -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog",
  "settings": [],
  "presets": [{ "name": "Blog" }]
}
{% endschema %}
