<div class="container">
  <div class="customer-page">
    <h1>{{ 'customer.reset_password.title' | t }}</h1>
    <p class="subtitle">{{ 'customer.reset_password.subtext' | t: email: email }}</p>
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}<div class="alert alert--error">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label>{{ 'customer.reset_password.password' | t }}</label><input type="password" name="customer[password]" required></div>
      <div class="field"><label>{{ 'customer.reset_password.password_confirm' | t }}</label><input type="password" name="customer[password_confirmation]" required></div>
      <button type="submit" class="btn btn-primary btn-full">{{ 'customer.reset_password.submit' | t }}</button>
    {%- endform -%}
  </div>
</div>
