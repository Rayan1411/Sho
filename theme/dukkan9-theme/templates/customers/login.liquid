<div class="container">
  <div class="customer-page">
    <h1>{{ 'customer.login.title' | t }}</h1>
    <p class="subtitle">{{ 'customer.login.title' | t }}</p>

    {%- form 'customer_login' -%}
      {%- if form.errors -%}
        <div class="alert alert--error">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="field">
        <label for="email">{{ 'customer.login.email' | t }}</label>
        <input type="email" id="email" name="customer[email]" autocomplete="email" required>
      </div>
      <div class="field">
        <label for="password">{{ 'customer.login.password' | t }}</label>
        <input type="password" id="password" name="customer[password]" autocomplete="current-password" required>
      </div>
      <button type="submit" class="btn btn-primary btn-full">{{ 'customer.login.sign_in' | t }}</button>
      <div class="aux-links">
        <a href="/account/register">{{ 'customer.register.title' | t }}</a>
        <a href="/account/forgot_password">{{ 'customer.login.forgot_password' | t }}</a>
      </div>
    {%- endform -%}
  </div>
</div>
