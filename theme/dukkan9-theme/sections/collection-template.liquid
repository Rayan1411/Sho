{%- liquid
  assign is_ar  = false
  if shop.locale == 'ar'
    assign is_ar = true
  endif
  assign sort_by = collection.sort_by | default: collection.default_sort_by
-%}

<!-- Collection header -->
<div class="coll-hero">
  <div class="container coll-hero__inner">
    {%- if collection.image -%}
      <img class="coll-hero__img"
           src="{{ collection.image | img_url: '1400x400', crop: 'center' }}"
           alt="{{ collection.title | escape }}" loading="eager">
      <div class="coll-hero__overlay"></div>
    {%- endif -%}
    <div class="coll-hero__content">
      <h1 class="coll-hero__title">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <p class="coll-hero__desc">{{ collection.description | strip_html | truncate: 160 }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

<!-- Breadcrumbs -->
<div class="container" style="padding-top:16px;">
  <nav class="breadcrumbs">
    <a href="/">{%- if is_ar -%}الرئيسية{%- else -%}Home{%- endif -%}</a>
    <span class="breadcrumbs__sep">›</span>
    <span>{{ collection.title }}</span>
  </nav>
</div>

<!-- Toolbar + grid -->
{%- paginate collection.products by 12 -%}
<div class="container coll-body">

  <!-- Toolbar -->
  <div class="coll-toolbar">
    <span class="coll-count">
      {%- if is_ar -%}
        {{ collection.products_count }} منتج
      {%- else -%}
        {{ collection.products_count }} products
      {%- endif -%}
    </span>

    <div class="coll-toolbar__right">
      <!-- Sort -->
      <div class="coll-sort">
        <label class="coll-sort__label" for="collSort">
          {%- if is_ar -%}ترتيب حسب:{%- else -%}Sort by:{%- endif -%}
        </label>
        <select id="collSort" class="coll-sort__select"
                onchange="window.location = window.location.pathname + '?sort_by=' + this.value + '&page=1'">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>
              {{ option.name }}
            </option>
          {%- endfor -%}
        </select>
      </div>

      <!-- Grid toggle -->
      <div class="coll-view-toggle">
        <button class="coll-view-btn active" data-cols="2" aria-label="2 columns">
          <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><rect x="2" y="2" width="9" height="9" rx="1"/><rect x="13" y="2" width="9" height="9" rx="1"/><rect x="2" y="13" width="9" height="9" rx="1"/><rect x="13" y="13" width="9" height="9" rx="1"/></svg>
        </button>
        <button class="coll-view-btn" data-cols="1" aria-label="1 column">
          <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><rect x="2" y="2" width="20" height="9" rx="1"/><rect x="2" y="13" width="20" height="9" rx="1"/></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Active filters (tag filtering) -->
  {%- if current_tags.size > 0 -%}
    <div class="coll-active-tags">
      {%- for tag in current_tags -%}
        <a href="{{ collection.url }}/{{ tag | url_encode | remove: '+' }}" class="coll-tag coll-tag--remove">
          {{ tag }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="12" height="12"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </a>
      {%- endfor -%}
      <a href="{{ collection.url }}" class="coll-tag coll-tag--clear">
        {%- if is_ar -%}مسح الكل{%- else -%}Clear all{%- endif -%}
      </a>
    </div>
  {%- endif -%}

  <div class="coll-layout" id="collLayout">

    <!-- Tag filter sidebar -->
    {%- if section.settings.show_filters and collection.all_tags.size > 0 -%}
      <aside class="coll-filters" id="collFilters">
        <h3 class="coll-filters__title">
          {%- if is_ar -%}تصفية المنتجات{%- else -%}Filter Products{%- endif -%}
        </h3>
        <div class="coll-filters__group">
          <h4>{%- if is_ar -%}الوسوم{%- else -%}Tags{%- endif -%}</h4>
          <ul class="coll-filters__list">
            {%- for tag in collection.all_tags -%}
              <li>
                {%- if current_tags contains tag -%}
                  <a href="{{ collection.url }}/{{ tag | url_encode | remove: '+' }}" class="coll-filter-link active">
                    <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14"><polyline points="20 6 9 17 4 12"/></svg>
                    {{ tag }}
                  </a>
                {%- else -%}
                  <a href="{{ collection.url }}/{{ tag | url_encode | remove: '+' }}" class="coll-filter-link">
                    <span class="coll-filter-check"></span>
                    {{ tag }}
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      </aside>
    {%- endif -%}

    <!-- Products grid -->
    <div class="coll-grid" id="collGrid">
      {%- for product in collection.products -%}
        {%- render 'product-card', product: product -%}
      {%- else -%}
        <div class="coll-empty">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="48" height="48" style="opacity:.3;"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          <p>{%- if is_ar -%}لا توجد منتجات في هذا التصنيف{%- else -%}No products found{%- endif -%}</p>
          <a href="/collections/all" class="btn btn-outline">
            {%- if is_ar -%}عرض جميع المنتجات{%- else -%}Browse all products{%- endif -%}
          </a>
        </div>
      {%- endfor -%}
    </div>

  </div>

  <!-- Pagination -->
  {%- if paginate.pages > 1 -%}
    <nav class="pagination" aria-label="Pagination">
      {%- if paginate.previous -%}
        <a href="{{ paginate.previous.url }}" class="pagination__btn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><polyline points="15 18 9 12 15 6"/></svg>
        </a>
      {%- endif -%}
      {%- for part in paginate.parts -%}
        {%- if part.is_link -%}
          <a href="{{ part.url }}" class="pagination__page">{{ part.title }}</a>
        {%- elsif part.title == paginate.current_page -%}
          <span class="pagination__page pagination__page--current">{{ part.title }}</span>
        {%- else -%}
          <span class="pagination__page pagination__page--gap">…</span>
        {%- endif -%}
      {%- endfor -%}
      {%- if paginate.next -%}
        <a href="{{ paginate.next.url }}" class="pagination__btn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
      {%- endif -%}
    </nav>
  {%- endif -%}

</div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "checkbox", "id": "show_filters", "label": "Show tag filters sidebar", "default": true }
  ],
  "presets": [{ "name": "Collection" }]
}
{% endschema %}
