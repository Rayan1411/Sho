{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign is_ar = false
  if shop.locale == 'ar'
    assign is_ar = true
  endif
-%}

<!-- Breadcrumbs -->
<div class="container" style="padding-top:20px;">
  <nav class="breadcrumbs" aria-label="breadcrumb">
    <a href="/">
      {%- if is_ar -%}الرئيسية{%- else -%}Home{%- endif -%}
    </a>
    <span class="breadcrumbs__sep">›</span>
    {%- if collection -%}
      <a href="{{ collection.url }}">{{ collection.title }}</a>
      <span class="breadcrumbs__sep">›</span>
    {%- endif -%}
    <span>{{ product.title }}</span>
  </nav>
</div>

<!-- Product layout -->
<div class="container pd-container">
  <div class="pd-layout">

    <!-- ── GALLERY ──────────────────────────────────────────── -->
    <div class="pd-gallery">

      <!-- Main image -->
      <div class="pd-gallery__main" id="pdMainImg">
        {%- if product.featured_image -%}
          <img id="pdMainImgEl"
               src="{{ current_variant.featured_image | default: product.featured_image | img_url: '900x900', crop: 'center' }}"
               alt="{{ product.featured_image.alt | default: product.title | escape }}"
               loading="eager" fetchpriority="high" width="900" height="900">
        {%- else -%}
          <div class="pd-gallery__placeholder">
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}

        <!-- Sale badge -->
        {%- if product.compare_at_price > product.price -%}
          {%- assign savings_pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
          <div class="pd-gallery__badge">-{{ savings_pct }}%</div>
        {%- endif -%}

        <!-- Nav arrows for mobile swipe -->
        {%- if product.images.size > 1 -%}
          <button class="pd-gallery__arrow pd-gallery__arrow--prev" id="pdPrev" aria-label="Previous image">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="20" height="20"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <button class="pd-gallery__arrow pd-gallery__arrow--next" id="pdNext" aria-label="Next image">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="20" height="20"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        {%- endif -%}
      </div>

      <!-- Thumbnails -->
      {%- if product.images.size > 1 -%}
        <div class="pd-gallery__thumbs" id="pdThumbs">
          {%- for image in product.images limit: 6 -%}
            <button class="pd-gallery__thumb{% if forloop.first %} active{% endif %}"
                    data-src="{{ image | img_url: '900x900', crop: 'center' }}"
                    data-idx="{{ forloop.index0 }}"
                    aria-label="Image {{ forloop.index }}">
              <img src="{{ image | img_url: '130x130', crop: 'center' }}"
                   alt="{{ image.alt | escape }}" loading="lazy" width="130" height="130">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    <!-- /GALLERY -->

    <!-- ── INFO ─────────────────────────────────────────────── -->
    <div class="pd-info">

      {%- if product.vendor != blank -%}
        <div class="pd-info__vendor">{{ product.vendor }}</div>
      {%- endif -%}

      <h1 class="pd-info__title">{{ product.title }}</h1>

      <!-- Rating placeholder -->
      <div class="pd-info__rating">
        <span class="pd-stars">★★★★★</span>
        <span class="pd-rating-count">
          {%- if is_ar -%}(اضغط لمراجعات العملاء){%- else -%}(Customer reviews){%- endif -%}
        </span>
      </div>

      <!-- Price -->
      <div class="pd-info__price" id="pdPrice">
        {%- if product.compare_at_price > product.price -%}
          <span class="pd-price-old">{{ product.compare_at_price | money }}</span>
          <span class="pd-price-main pd-price-main--sale">{{ product.price | money }}</span>
          <span class="pd-price-save">
            {%- if is_ar -%}وفّر{%- else -%}Save{%- endif -%}
            {{ product.compare_at_price | minus: product.price | money }}
          </span>
        {%- else -%}
          <span class="pd-price-main">{{ current_variant.price | money }}</span>
        {%- endif -%}
      </div>

      <!-- Availability -->
      <div class="pd-info__avail" id="pdAvail">
        {%- if current_variant.available -%}
          <span class="pd-avail pd-avail--in">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="16" height="16"><polyline points="20 6 9 17 4 12"/></svg>
            {%- if is_ar -%}متوفر في المخزون{%- else -%}In stock{%- endif -%}
          </span>
        {%- else -%}
          <span class="pd-avail pd-avail--out">
            {%- if is_ar -%}نفذ المخزون{%- else -%}Out of stock{%- endif -%}
          </span>
        {%- endif -%}
      </div>

      <div class="pd-divider"></div>

      <!-- Product form -->
      {%- form 'product', product, id: 'addToCartForm', novalidate: true -%}

        <!-- Variants -->
        {%- unless product.has_only_default_variant -%}
          <div class="pd-variants" id="pdVariants">
            {%- for option in product.options_with_values -%}
              <div class="pd-option">
                <div class="pd-option__label">
                  {{ option.name }}:
                  <strong id="pdOptVal{{ option.position }}">{{ option.selected_value }}</strong>
                </div>
                <div class="pd-option__btns">
                  {%- for value in option.values -%}
                    <button type="button"
                            class="pd-opt-btn{% if option.selected_value == value %} active{% endif %}"
                            data-option="{{ option.position }}"
                            data-value="{{ value | escape }}">
                      {{ value }}
                    </button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
            <input type="hidden" name="id" id="variantId" value="{{ current_variant.id }}">
          </div>
        {%- else -%}
          <input type="hidden" name="id" value="{{ product.variants.first.id }}">
        {%- endunless -%}

        <!-- Quantity + Add to cart -->
        <div class="pd-form__row">
          <div class="pd-qty">
            <button type="button" class="pd-qty__btn" data-action="minus" aria-label="Decrease">−</button>
            <input type="number" name="quantity" value="1" min="1" max="99"
                   class="pd-qty__input" aria-label="{%- if is_ar -%}الكمية{%- else -%}Quantity{%- endif -%}">
            <button type="button" class="pd-qty__btn" data-action="plus" aria-label="Increase">+</button>
          </div>
          <button type="submit" id="pdAddBtn"
                  class="btn btn-primary pd-add-btn"
                  {%- unless current_variant.available -%}disabled{%- endunless -%}>
            {%- if current_variant.available -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
              {%- if is_ar -%}أضف إلى السلة{%- else -%}Add to Cart{%- endif -%}
            {%- else -%}
              {%- if is_ar -%}نفذ المخزون{%- else -%}Sold Out{%- endif -%}
            {%- endif -%}
          </button>
        </div>

        <!-- Buy Now -->
        {%- if current_variant.available -%}
          <button type="submit" name="checkout" class="btn pd-buy-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            {%- if is_ar -%}اشتر الآن{%- else -%}Buy Now{%- endif -%}
          </button>
        {%- endif -%}

        <!-- Cart notification -->
        <div class="pd-cart-notice" id="pdCartNotice" style="display:none;"></div>

      {%- endform -%}

      <!-- Trust badges -->
      <div class="pd-trust">
        <div class="pd-trust__item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          <div>
            <strong>{%- if is_ar -%}شحن سريع{%- else -%}Fast Shipping{%- endif -%}</strong>
            <span>{%- if is_ar -%}1-3 أيام عمل{%- else -%}1-3 business days{%- endif -%}</span>
          </div>
        </div>
        <div class="pd-trust__item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <div>
            <strong>{%- if is_ar -%}دفع آمن{%- else -%}Secure Payment{%- endif -%}</strong>
            <span>{%- if is_ar -%}مشفر 100%{%- else -%}100% encrypted{%- endif -%}</span>
          </div>
        </div>
        <div class="pd-trust__item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-4.5"/></svg>
          <div>
            <strong>{%- if is_ar -%}إرجاع مجاني{%- else -%}Free Returns{%- endif -%}</strong>
            <span>{%- if is_ar -%}خلال 14 يوم{%- else -%}Within 14 days{%- endif -%}</span>
          </div>
        </div>
      </div>

      <!-- Description accordion -->
      {%- if product.description != blank -%}
        <div class="pd-accordion">
          <button class="pd-accordion__btn" type="button" aria-expanded="true" id="pdDescBtn">
            <span>{%- if is_ar -%}وصف المنتج{%- else -%}Product Description{%- endif -%}</span>
            <svg class="pd-accordion__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="18" height="18"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="pd-accordion__body" id="pdDescBody">
            <div class="pd-description">{{ product.description }}</div>
          </div>
        </div>
      {%- endif -%}

      <!-- Share -->
      <div class="pd-share">
        <span class="pd-share__label">{%- if is_ar -%}شارك:{%- else -%}Share:{%- endif -%}</span>
        <a href="https://wa.me/?text={{ product.title | url_encode }}%20{{ shop.url }}{{ product.url }}"
           target="_blank" rel="noopener" class="pd-share__btn" aria-label="WhatsApp">
          <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
        </a>
        <a href="https://twitter.com/intent/tweet?text={{ product.title | url_encode }}&url={{ shop.url }}{{ product.url }}"
           target="_blank" rel="noopener" class="pd-share__btn" aria-label="Twitter">
          <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <button class="pd-share__btn pd-share__copy" data-url="{{ shop.url }}{{ product.url }}" aria-label="Copy link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
        </button>
      </div>

    </div>
    <!-- /INFO -->
  </div>

  <!-- Variant data for JS -->
  <script id="pdVariantData" type="application/json">
    {{ product.variants | json }}
  </script>

</div>

<!-- Related products -->
{%- if section.settings.show_related -%}
  {%- assign related = collections[product.collections.first.handle].products -%}
  {%- if related.size > 1 -%}
    <div class="container pd-related">
      <h2 class="pd-related__title">
        {%- if is_ar -%}منتجات مشابهة{%- else -%}You May Also Like{%- endif -%}
      </h2>
      <div class="pd-related__grid">
        {%- for rp in related limit: 4 -%}
          {%- unless rp.id == product.id -%}
            {%- render 'product-card', product: rp -%}
          {%- endunless -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "checkbox", "id": "show_related", "label": "Show related products", "default": true }
  ],
  "presets": [{ "name": "Product" }]
}
{% endschema %}
