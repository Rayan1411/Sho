<section class="section">
  <div class="container">
    <div style="max-width:560px;margin-inline:auto;margin-bottom:40px;text-align:center;">
      <h1 style="margin-bottom:20px;">{{ 'general.search.title' | t }}</h1>
      {%- form 'search' -%}
        <div style="display:flex;gap:0;border:1.5px solid var(--c-border);border-radius:var(--r-full);overflow:hidden;">
          <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}"
                 style="flex:1;padding:14px 20px;border:none;outline:none;font-size:1rem;{% if request.locale.iso_code == 'ar' %}direction:rtl;text-align:right;{% endif %}">
          <button type="submit" class="btn btn-primary" style="border-radius:0;padding:14px 24px;">
            {{ 'general.search.submit' | t }}
          </button>
        </div>
      {%- endform -%}
    </div>

    {%- if search.performed -%}
      {%- if search.results_count == 0 -%}
        <p style="text-align:center;color:var(--c-text-m);">{{ 'general.search.no_results_html' | t: terms: search.terms }}</p>
      {%- else -%}
        <p style="text-align:center;color:var(--c-text-m);margin-bottom:32px;">{{ 'general.search.results_for_html' | t: terms: search.terms }}</p>
        {%- paginate search.results by 12 -%}
          <div class="products-grid">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {%- render 'product-card', product: item -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
          {%- render 'pagination', paginate: paginate -%}
        {%- endpaginate -%}
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search",
  "settings": [],
  "presets": [{ "name": "Search" }]
}
{% endschema %}
