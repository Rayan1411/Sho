{%- liquid
  assign show_vendor    = show_vendor    | default: false
  assign img_size       = img_size       | default: '500x500'
  assign card_class     = card_class     | default: ''
  assign on_sale        = false
  assign sold_out       = false
  if product.available == false
    assign sold_out = true
  endif
  if product.compare_at_price > product.price
    assign on_sale = true
    assign pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price
  endif
-%}
<div class="pcard {{ card_class }}">

  <!-- Image -->
  <div class="pcard__media">
    <a href="{{ product.url }}" class="pcard__img-link" tabindex="-1" aria-label="{{ product.title | escape }}">
      {%- if product.images.size > 1 -%}
        <img class="pcard__img pcard__img--primary"
             src="{{ product.images[0] | img_url: img_size, crop: 'center' }}"
             alt="{{ product.images[0].alt | default: product.title | escape }}"
             loading="lazy" width="500" height="500">
        <img class="pcard__img pcard__img--hover"
             src="{{ product.images[1] | img_url: img_size, crop: 'center' }}"
             alt="{{ product.images[1].alt | default: product.title | escape }}"
             loading="lazy" width="500" height="500">
      {%- elsif product.featured_image -%}
        <img class="pcard__img pcard__img--primary"
             src="{{ product.featured_image | img_url: img_size, crop: 'center' }}"
             alt="{{ product.featured_image.alt | default: product.title | escape }}"
             loading="lazy" width="500" height="500">
      {%- else -%}
        <div class="pcard__placeholder">
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {%- endif -%}
    </a>

    <!-- Badges -->
    <div class="pcard__badges">
      {%- if sold_out -%}
        <span class="pcard__badge pcard__badge--soldout">
          {%- if shop.locale == 'ar' -%}نفذ المخزون{%- else -%}Sold Out{%- endif -%}
        </span>
      {%- elsif on_sale -%}
        <span class="pcard__badge pcard__badge--sale">-{{ pct }}%</span>
      {%- endif -%}
    </div>

    <!-- Quick add -->
    {%- unless sold_out -%}
      <div class="pcard__actions">
        {%- form 'product', product, class: 'pcard__quick-form' -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <button type="submit" class="pcard__quick-btn" aria-label="{%- if shop.locale == 'ar' -%}أضف للسلة{%- else -%}Add to cart{%- endif -%}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
              <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
              <line x1="3" y1="6" x2="21" y2="6"/>
              <path d="M16 10a4 4 0 0 1-8 0"/>
            </svg>
            {%- if shop.locale == 'ar' -%}أضف للسلة{%- else -%}Add to cart{%- endif -%}
          </button>
        {%- endform -%}
        <a href="{{ product.url }}" class="pcard__view-btn" aria-label="{%- if shop.locale == 'ar' -%}عرض المنتج{%- else -%}View product{%- endif -%}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
            <circle cx="12" cy="12" r="3"/>
          </svg>
        </a>
      </div>
    {%- endunless -%}
  </div>

  <!-- Info -->
  <div class="pcard__info">
    {%- if show_vendor and product.vendor != blank -%}
      <div class="pcard__vendor">{{ product.vendor }}</div>
    {%- endif -%}
    <a href="{{ product.url }}" class="pcard__title">{{ product.title }}</a>
    <div class="pcard__price">
      {%- if on_sale -%}
        <span class="pcard__price-compare">{{ product.compare_at_price | money }}</span>
        <span class="pcard__price-main pcard__price-main--sale">{{ product.price | money }}</span>
      {%- else -%}
        <span class="pcard__price-main">{{ product.price | money }}</span>
      {%- endif -%}
    </div>
  </div>

</div>
