{%- assign is_rtl = false -%}
{%- if shop.locale == 'ar' -%}{%- assign is_rtl = true -%}{%- endif -%}
{%- if is_rtl -%}{%- assign dir = 'rtl' -%}{%- else -%}{%- assign dir = 'ltr' -%}{%- endif -%}
<!doctype html>
<html lang="{{ shop.locale }}" dir="{{ dir }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#644EBB">

  <title>
    {%- if page_title == shop.name or page_title == blank -%}
      {%- if shop.locale == 'ar' -%}دكان 9{%- else -%}Dukkan9{%- endif -%}
    {%- else -%}
      {{ page_title }} — {%- if shop.locale == 'ar' -%}دكان 9{%- else -%}Dukkan9{%- endif -%}
    {%- endif -%}
  </title>

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  {%- if settings.favicon -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | img_url: '32x32' }}">
    <link rel="apple-touch-icon" href="{{ settings.favicon | img_url: '180x180' }}">
  {%- else -%}
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='8' fill='%23644EBB'/><text x='50%25' y='60%25' font-size='18' text-anchor='middle' fill='white' font-family='Arial'>9</text></svg>">
  {%- endif -%}

  {%- if canonical_url -%}<link rel="canonical" href="{{ canonical_url }}">{%- endif -%}

  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <style>
    #sidebarOverlay{position:fixed;inset:0;background:rgba(19,17,58,.55);z-index:299;opacity:0;pointer-events:none;transition:opacity .3s;backdrop-filter:blur(3px);}
    #sidebarOverlay.is-open{opacity:1;pointer-events:all;}
    #sidebar{position:fixed;top:0;inset-inline-start:0;left:0;width:300px;max-width:88vw;height:100%;background:#fff;z-index:300;transform:translateX(-100%);transition:transform .32s cubic-bezier(.4,0,.2,1);overflow-y:auto;display:flex;flex-direction:column;box-shadow:4px 0 40px rgba(100,78,187,.18);}
    [dir="rtl"] #sidebar{left:auto;right:0;transform:translateX(100%);}
    #sidebar.is-open{transform:translateX(0)!important;}
    #mobileOverlay{display:none!important;}
    #mobileDrawer{display:none!important;}
  </style>

  <script>
    window.theme_strings = {
      adding:             {{ 'products.product.adding' | t | json }},
      added:              {{ 'products.product.added' | t | json }},
      error:              {{ 'products.product.error' | t | json }},
      newsletter_success: {{ 'general.newsletter_form.newsletter_confirmation' | t | json }}
    };
    window.Shopify = window.Shopify || {};
    window.Shopify.locale = {{ shop.locale | json }};
  </script>

  {{ content_for_header }}
</head>

<body class="template-{{ request.page_type | handle }}">

  <!-- ══════════════════════════════════════════════════════
       SIDEBAR — slides in from start edge on ALL screen sizes
       ══════════════════════════════════════════════════════ -->
  <div id="sidebarOverlay" aria-hidden="true"></div>

  <aside id="sidebar" role="dialog" aria-modal="true"
         aria-label="{%- if shop.locale == 'ar' -%}القائمة الرئيسية{%- else -%}Main Menu{%- endif -%}">

    <!-- Sidebar header -->
    <div class="sb__header">
      <a href="/" class="sb__logo">
        {%- if shop.locale == 'ar' -%}دكان 9{%- else -%}Dukkan9{%- endif -%}
        <span class="sb__logo-dot"></span>
      </a>
      <button id="sidebarClose" class="sb__close" aria-label="{%- if shop.locale == 'ar' -%}إغلاق القائمة{%- else -%}Close menu{%- endif -%}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="20" height="20">
          <path d="M18 6 6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Search bar inside sidebar -->
    <div class="sb__search">
      <form action="/search" method="get">
        <input type="search" name="q" class="sb__search-input"
               placeholder="{%- if shop.locale == 'ar' -%}ابحث في المتجر...{%- else -%}Search store...{%- endif -%}"
               autocomplete="off">
        <button type="submit" class="sb__search-btn" aria-label="{%- if shop.locale == 'ar' -%}بحث{%- else -%}Search{%- endif -%}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
        </button>
      </form>
    </div>

    <!-- Main navigation links -->
    <nav class="sb__nav" aria-label="{%- if shop.locale == 'ar' -%}التنقل الرئيسي{%- else -%}Main navigation{%- endif -%}">
      <p class="sb__nav-label">
        {%- if shop.locale == 'ar' -%}الأقسام{%- else -%}Browse{%- endif -%}
      </p>
      {%- for link in linklists[settings.menu].links -%}
        <a href="{{ link.url }}"
           class="sb__link{% if link.active %} sb__link--active{% endif %}"
           {%- if link.active %} aria-current="page"{% endif %}>
          <!-- Smart icon per link title -->
          {%- assign lt = link.title | downcase -%}
          {%- if lt contains 'home' or lt contains 'الرئيسية' -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          {%- elsif lt contains 'catalog' or lt contains 'product' or lt contains 'منتج' or lt contains 'تسوق' -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          {%- elsif lt contains 'blog' or lt contains 'news' or lt contains 'مدونة' or lt contains 'أخبار' -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M4 4h16v16H4z" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>
          {%- elsif lt contains 'contact' or lt contains 'تواصل' -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          {%- elsif lt contains 'about' or lt contains 'عن' -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          {%- else -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><polyline points="9 18 15 12 9 6"/></svg>
          {%- endif -%}
          {{ link.title }}
        </a>
      {%- endfor -%}
    </nav>

    <!-- Quick actions section -->
    <div class="sb__section">
      <p class="sb__nav-label">
        {%- if shop.locale == 'ar' -%}روابط سريعة{%- else -%}Quick Actions{%- endif -%}
      </p>
      <a href="/collections/all" class="sb__link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
        {%- if shop.locale == 'ar' -%}جميع المنتجات{%- else -%}All Products{%- endif -%}
      </a>
      <a href="/cart" class="sb__link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        {%- if shop.locale == 'ar' -%}سلة التسوق{%- else -%}Shopping Cart{%- endif -%}
        {%- if cart.item_count > 0 -%}
          <span class="sb__badge">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
      {%- if shop.customer_accounts_enabled -%}
        <a href="{%- if customer -%}/account{%- else -%}/account/login{%- endif -%}" class="sb__link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          {%- if customer -%}
            {%- if shop.locale == 'ar' -%}حسابي{%- else -%}My Account{%- endif -%}
          {%- else -%}
            {%- if shop.locale == 'ar' -%}تسجيل الدخول{%- else -%}Log In{%- endif -%}
          {%- endif -%}
        </a>
      {%- endif -%}
    </div>

    <!-- Policies section -->
    <div class="sb__section">
      <p class="sb__nav-label">
        {%- if shop.locale == 'ar' -%}السياسات{%- else -%}Policies{%- endif -%}
      </p>
      <a href="/policies/privacy-policy" class="sb__link sb__link--sm">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        {%- if shop.locale == 'ar' -%}سياسة الخصوصية{%- else -%}Privacy Policy{%- endif -%}
      </a>
      <a href="/policies/refund-policy" class="sb__link sb__link--sm">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-4.5"/></svg>
        {%- if shop.locale == 'ar' -%}سياسة الاسترجاع{%- else -%}Return Policy{%- endif -%}
      </a>
      <a href="/policies/shipping-policy" class="sb__link sb__link--sm">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        {%- if shop.locale == 'ar' -%}سياسة الشحن{%- else -%}Shipping Policy{%- endif -%}
      </a>
      <a href="/policies/terms-of-service" class="sb__link sb__link--sm">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        {%- if shop.locale == 'ar' -%}الشروط والأحكام{%- else -%}Terms of Service{%- endif -%}
      </a>
    </div>

    <!-- Language switcher -->
    {%- if localization.available_languages.size > 1 -%}
      <div class="sb__section sb__lang-section">
        <p class="sb__nav-label">
          {%- if shop.locale == 'ar' -%}اللغة{%- else -%}Language{%- endif -%}
        </p>
        {%- form 'localization' -%}
          <div class="sb__lang-btns">
            {%- for language in localization.available_languages -%}
              <button type="submit" name="locale_code" value="{{ language.iso_code }}"
                      class="sb__lang-btn{% if language.iso_code == localization.language.iso_code %} sb__lang-btn--active{% endif %}">
                {%- if language.iso_code == 'ar' -%}🇸🇦 العربية
                {%- elsif language.iso_code == 'en' -%}🇬🇧 English
                {%- else -%}{{ language.endonym_name }}{%- endif -%}
              </button>
            {%- endfor -%}
          </div>
        {%- endform -%}
      </div>
    {%- endif -%}

    <!-- Sidebar footer -->
    <div class="sb__footer">
      <div class="sb__footer-social">
        <a href="#" aria-label="Instagram" class="sb__social-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="18" height="18"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
        </a>
        <a href="#" aria-label="TikTok" class="sb__social-icon">
          <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.34 6.34 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.94a8.22 8.22 0 0 0 4.81 1.54V7.04a4.85 4.85 0 0 1-1.04-.35z"/></svg>
        </a>
        <a href="#" aria-label="WhatsApp" class="sb__social-icon sb__social-icon--wa">
          <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
        </a>
      </div>
      <p class="sb__copy">
        © {{ 'now' | date: '%Y' }}
        {%- if shop.locale == 'ar' -%}دكان 9{%- else -%}Dukkan9{%- endif -%}
      </p>
    </div>
  </aside>
  <!-- END SIDEBAR -->

  {%- section 'announcement' -%}
  {%- section 'header' -%}

  <main id="MainContent" role="main">
    {{ content_for_layout }}
  </main>

  {%- section 'footer' -%}

  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
